<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BRUSH TOKENS (colors inlined — avoids WMC designer warnings for <Color> elements) -->
    <SolidColorBrush x:Key="Brush.Primary"              Color="#FFFF7900" />  <!-- Standard Orange Brand -->
    <SolidColorBrush x:Key="Brush.Primary.Hover"        Color="#FFE66000" />  <!-- Darker Orange -->

    <SolidColorBrush x:Key="Brush.Background.Page"      Color="#FF0A0A0A" />  <!-- Deep Black -->
    <SolidColorBrush x:Key="Brush.Background.Card"      Color="#FF1F1F1F" />  <!-- Industrial Dark Grey -->

    <SolidColorBrush x:Key="Brush.Text.Primary"         Color="#FFFFFFFF" />  <!-- Primary Text -->
    <SolidColorBrush x:Key="Brush.Text.Muted"           Color="#FF999999" />  <!-- Muted Text -->

    <SolidColorBrush x:Key="Brush.Status.Success"       Color="#FF00CC6A" />
    <SolidColorBrush x:Key="Brush.Status.Warning"       Color="#FFFFCC00" />
    <SolidColorBrush x:Key="Brush.Status.Error"         Color="#FFCC3300" />

    <!-- NAVIGATION VIEW OVERRIDES (Fix Blue Highlight) -->
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"               Color="#FFFF7900" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForegroundPointerOver"    Color="#FFE66000" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForegroundPressed"        Color="#FFE66000" />

    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected"             Color="#33FF7900" />  <!-- Semi-transparent Orange -->
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver"  Color="#44FF7900" />

    <!-- Button Foreground Overrides for Dark Theme Reliability -->
    <SolidColorBrush x:Key="NavigationViewButtonForeground"              Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewButtonForegroundPointerOver"   Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewButtonForegroundPressed"       Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForeground"                Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver"     Color="#FFFFFFFF" />

</ResourceDictionary>
